page {
  --primary: #E595A8;
  --primary-light: #F5D6DF;
  --bg: #F8F4F6;
  --surface: #FFFFFF;
  --text: #3A2A30;
  --muted: #A89098;
  --border: #EDE4E7;
  --chip-bg: #F8F4F6;
  --radius: 14px;
  --radius-sm: 10px;
  font-family: PingFang SC, -apple-system, Helvetica Neue, Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 13px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  height: 100%;
}

.card {
  background: var(--surface);
  border-radius: var(--radius);
  border: 1px solid var(--border);
  padding: 14px 16px;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
  border: none;
  padding: 8px 16px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 500;
  line-height: 1;
}

.btn-outline {
  background: var(--surface);
  color: var(--muted);
  border: 1px solid var(--border);
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 500;
  line-height: 1;
}

.btn-outline-active {
  background: var(--primary-light);
  color: var(--text);
  border: 1px solid var(--primary);
  padding: 6px 14px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-weight: 500;
  line-height: 1;
}

.swatch {
  width: 38px;
  height: 28px;
  border-radius: 8px;
  flex-shrink: 0;
}

.name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
}

.meta {
  font-size: 11px;
  color: var(--muted);
}
