/** 全局样式（极简现代 - 粉色主题） **/
page{padding:18px;font-family:PingFang SC, "Helvetica Neue", Arial;background:#fff7fb}
.header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;padding:10px 12px;border-radius:12px}
.card{padding:14px;background:#fff;border-radius:12px;margin-bottom:12px;box-shadow:0 6px 18px rgba(230,195,210,0.35);border:1px solid rgba(0,0,0,0.03)}
.thumb{width:40px;height:28px;border-radius:6px;border:1px solid rgba(0,0,0,0.06)}
.name{font-weight:700;color:#2b2b2b}
.meta{font-size:12px;color:#9b8b9b}
.btn-primary{background:#ff6fa3;color:#fff;padding:8px 12px;border-radius:10px;border:none}
.cat-btn{margin:4px 6px;padding:6px 10px;border-radius:20px;border:1px solid rgba(0,0,0,0.06);background:transparent;color:#2b2b2b}
.swatch{width:32px;height:24px;border-radius:6px;border:1px solid rgba(0,0,0,0.06)}
