.page-wrap { display: flex; flex-direction: column; height: 100vh; padding: 40rpx 32rpx 0; box-sizing: border-box; background: var(--bg); color: var(--text); position: relative; }
.page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.page-title { font-size: 20px; font-weight: 700; color: var(--text); }
.header-actions { display: flex; gap: 8px; }
.header-btn { font-size: 13px; color: var(--primary); background: var(--primary-light); padding: 6px 14px; border-radius: 16px; font-weight: 500; }
.page-subtitle { font-size: 12px; color: var(--muted); display: block; margin-bottom: 14px; }
.filter-bar { display: flex; align-items: center; gap: 6px; margin-bottom: 14px; }
.filter-tag-scroll { flex: 1; overflow: hidden; }
.filter-tag-row { display: flex; gap: 6px; padding: 2px 0; }
.filter-placeholder { font-size: 12px; color: var(--muted); padding: 6px 0; }
.filter-tag { display: flex; align-items: center; gap: 3px; font-size: 12px; color: var(--primary); background: var(--primary-light); border: 1px solid var(--primary); padding: 4px 10px; border-radius: 16px; white-space: nowrap; flex-shrink: 0; }
.filter-tag-x { font-size: 10px; margin-left: 2px; }
.filter-btn { font-size: 12px; color: var(--primary); padding: 6px 12px; background: var(--surface); border: 1px solid var(--primary); border-radius: 16px; white-space: nowrap; flex-shrink: 0; }
.list-scroll { flex: 1; height: 0; overflow: hidden; padding-bottom: 120px; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding: 60px 0; }
.empty-icon { font-size: 36px; margin-bottom: 10px; }
.empty-text { font-size: 15px; font-weight: 500; color: var(--text); margin-bottom: 4px; }
.empty-hint { font-size: 12px; color: var(--muted); }
.loading-hint { text-align: center; padding: 40px; color: var(--muted); font-size: 13px; }
.post-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; margin-bottom: 8px; }
.post-author { display: flex; align-items: center; gap: 6px; margin-bottom: 6px; }
.author-avatar { font-size: 16px; }
.author-name { font-size: 12px; font-weight: 600; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 120px; }
.post-time { font-size: 10px; color: var(--muted); margin-left: auto; }
.post-title { font-size: 13px; font-weight: 600; color: var(--text); display: block; margin-bottom: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.post-desc { font-size: 11px; color: var(--muted); line-height: 1.4; display: block; margin-bottom: 6px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; word-break: break-all; }
.post-bottom { display: flex; align-items: center; justify-content: space-between; }
.post-tags { display: flex; flex-wrap: wrap; gap: 4px; flex: 1; min-width: 0; overflow: hidden; }
.post-tag { font-size: 10px; color: var(--primary); background: var(--primary-light); padding: 2px 8px; border-radius: 6px; white-space: nowrap; }
.post-meta { display: flex; align-items: center; gap: 8px; font-size: 10px; color: var(--muted); flex-shrink: 0; margin-left: 8px; }
.post-prod-count { display: flex; align-items: center; gap: 2px; }
.post-fav-count { display: flex; align-items: center; gap: 2px; }
.filter-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.35); z-index: 99; }
.filter-panel { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-radius: 16px 16px 0 0; z-index: 100; max-height: 70vh; display: flex; flex-direction: column; transition: transform .2s ease; }
.filter-panel-handle { display: flex; justify-content: center; padding: 8px 0 0; }
.filter-handle-bar { width: 36px; height: 4px; background: #ddd; border-radius: 2px; }
.filter-panel-header { display: flex; align-items: center; justify-content: space-between; padding: 8px 16px 0; }
.filter-panel-title { font-size: 16px; font-weight: 600; color: var(--text); }
.filter-panel-close { font-size: 16px; color: var(--muted); padding: 4px 8px; }
.filter-panel-body { flex: 1; height: 0; overflow: hidden; padding: 12px 16px; }
.filter-cat-title { font-size: 13px; font-weight: 600; color: var(--text); margin-top: 12px; margin-bottom: 8px; }
.filter-cat-title:first-child { margin-top: 0; }
.filter-options { display: flex; flex-wrap: wrap; gap: 6px; }
.filter-opt { padding: 6px 14px; font-size: 12px; color: var(--muted); background: var(--surface); border: 1px solid var(--border); border-radius: 16px; }
.filter-opt-on { border-color: var(--primary); color: var(--primary); background: var(--primary-light); }
.filter-panel-actions { display: flex; gap: 10px; padding: 12px 16px 24px; border-top: 1px solid var(--border); }
.filter-btn-reset { flex: 1; padding: 10px 0; text-align: center; font-size: 13px; color: var(--muted); background: var(--surface); border: 1px solid var(--border); border-radius: 12px; }
.filter-btn-confirm { flex: 2; padding: 10px 0; text-align: center; font-size: 13px; color: #fff; background: var(--primary); border: none; border-radius: 12px; font-weight: 500; }
