<view class="page-wrap" style="background:{{theme.colors.primaryBg}};color:{{theme.colors.text}}">
  <view class="page-title">我的清单</view>
  <text class="page-subtitle">已收集 {{items.length}} 件商品</text>

  <block wx:if="{{items.length===0}}">
    <view class="empty-state">
      <text class="empty-icon">📋</text>
      <text class="empty-text">清单还是空的</text>
      <text class="empty-hint">在「化妆清单」中添加感兴趣的商品</text>
    </view>
    <block wx:if="{{hotItems.length>0}}">
      <view class="hot-section">
        <view class="hot-header">
          <text class="hot-title">🔥 大家都在加</text>
        </view>
        <scroll-view scroll-x="true" class="hot-scroll">
          <view class="hot-row">
            <block wx:for="{{hotItems}}" wx:for-item="item" wx:key="id">
              <view class="hot-card">
                <view class="hot-swatch" style="background:{{item.hex || '#f4f4f4'}}"></view>
                <text class="hot-brand">{{item.brand}}</text>
                <text class="hot-name">{{item.name}}</text>
                <text class="hot-price">¥{{item.price}}</text>
                <button bindtap="onAddHotItem" data-id="{{item.id}}" class="hot-add-btn">+</button>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>
    </block>
    <view class="empty-footer">
      <button bindtap="goChecklist" class="btn-primary" style="padding:10px 24px;font-size:13px">去化妆清单选购</button>
    </view>
  </block>

  <block wx:if="{{items.length>0}}">
    <scroll-view scroll-y="true" style="flex:1;min-height:0;padding-bottom:60px;box-sizing:content-box">
      <block wx:for="{{groups}}" wx:for-item="group" wx:key="title">
        <view class="cart-group">
          <view class="cart-group-header">
            <text class="cart-group-title">{{group.title}}</text>
            <text class="cart-group-count">{{group.items.length}} 件</text>
          </view>
          <block wx:for="{{group.items}}" wx:for-item="item" wx:key="id">
            <view class="cart-item">
              <view bindtap="onTapItem" data-id="{{item.id}}" hover-class="item-hover" class="cart-item-main">
                <view class="cart-item-left">
                  <view class="swatch cart-swatch" style="background:{{item.hex || '#f4f4f4'}}"></view>
                </view>
                <view class="cart-item-info">
                  <text class="name">{{item.name}}</text>
                  <text class="meta">{{item.brand}} · {{item.colorName}}</text>
                  <text class="cart-price">¥{{item.price}}</text>
                </view>
              </view>
              <button bindtap="onRemoveItem" data-id="{{item.id}}" class="btn-remove-item">✕</button>
            </view>
          </block>
        </view>
      </block>
    </scroll-view>
  </block>
</view>

<view wx:if="{{items.length>0}}" class="cart-bottom">
  <view class="cart-total">
    <text class="total-label">合计</text>
    <text class="total-price">¥{{totalPrice}}</text>
  </view>
  <button bindtap="clearCart" class="btn-outline btn-clear" style="background:{{theme.colors.surface}};color:{{theme.colors.muted}};border-color:{{theme.colors.border}}">清空清单</button>
  <button bindtap="goChecklist" class="btn-primary btn-continue" style="background:{{theme.colors.accent}}">继续选购</button>
</view>
