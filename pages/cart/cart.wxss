.page-wrap {
  padding: 20px 16px;
  min-height: calc(100vh - 60px);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  color: var(--text);
}
.page-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 4px;
}
.page-subtitle {
  font-size: 12px;
  color: var(--muted);
  display: block;
  margin-bottom: 16px;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 0;
}
.empty-icon {
  font-size: 40px;
  margin-bottom: 12px;
}
.empty-text {
  font-size: 15px;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 4px;
}
.empty-hint {
  font-size: 12px;
  color: var(--muted);
}
.cart-group {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 16px;
  margin-bottom: 12px;
}
.cart-group-header {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
}
.cart-group-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}
.cart-group-count {
  font-size: 11px;
  color: var(--muted);
  margin-left: auto;
}
.cart-item {
  display: flex;
  gap: 12px;
  padding: 10px 0;
  border-top: 1px solid var(--bg);
  align-items: center;
}
.cart-item-main {
  display: flex;
  gap: 12px;
  flex: 1;
  min-width: 0;
}
.cart-item:first-of-type {
  border-top: none;
}
.cart-item:last-of-type {
  padding-bottom: 0;
}
.item-hover {
  background: var(--chip-bg);
  border-radius: 8px;
}
.cart-item-left {
  flex-shrink: 0;
}
.cart-swatch {
  width: 44px;
  height: 44px;
  border-radius: 10px;
}
.cart-item-info {
  flex: 1;
  min-width: 0;
}
.cart-item-info .name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
}
.btn-remove-item {
  flex-shrink: 0;
  width: 24px;
  height: 24px;
  line-height: 24px;
  padding: 0;
  margin: 0;
  font-size: 12px;
  color: var(--muted);
  background: none;
  text-align: center;
  border-radius: 50%;
}
.btn-remove-item::after {
  border: none;
}
.cart-item-info .meta {
  font-size: 11px;
  color: var(--muted);
  display: block;
  margin-top: 1px;
}
.cart-price {
  font-size: 14px;
  font-weight: 600;
  color: var(--primary);
  display: block;
  margin-top: 4px;
}
.cart-bottom {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 10px;
  padding: 10px 16px;
  background: var(--surface);
  border-top: 1px solid var(--border);
  box-shadow: 0 -2px 12px rgba(0,0,0,0.04);
  align-items: center;
}
.cart-total {
  display: flex;
  flex-direction: column;
  margin-right: auto;
}
.total-label {
  font-size: 11px;
  color: var(--muted);
}
.total-price {
  font-size: 17px;
  font-weight: 700;
  color: var(--primary);
}
.btn-clear {
  flex: 1;
  padding: 10px;
  text-align: center;
  font-size: 13px;
  border-radius: 10px;
}
.btn-continue {
  flex: 1;
  padding: 10px;
  text-align: center;
  font-size: 13px;
  border-radius: 10px;
}
