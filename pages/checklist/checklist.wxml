<view class="page-wrap">
  <view class="layout">
    <scroll-view class="sidebar" scroll-y="true" enable-back-to-top>
      <block wx:for="{{categories.groups}}" wx:for-item="group" wx:for-index="gi" wx:key="gi">
        <view bindtap="onToggleGroup" data-gi="{{gi}}" class="group-label">
          <text>{{group.title}}</text>
          <text class="group-arrow {{collapsedGroups[gi] ? 'group-arrow-collapsed' : ''}}">▾</text>
        </view>
        <block wx:if="{{!collapsedGroups[gi]}}" wx:for="{{group.items}}" wx:for-item="cat" wx:for-index="ci" wx:key="cat">
          <view bindtap="onSelectCategory" data-cat="{{cat}}"
            class="nav-item {{selectedCat===cat ? 'nav-item-active' : ''}}">{{cat}}</view>
        </block>
      </block>
    </scroll-view>

    <view class="content">
      <view class="content-top">
        <view class="content-header">
          <view class="content-header-left">
            <text class="content-title">{{selectedCat || '选择品类'}}</text>
            <text class="result-count">{{filteredCount}} 件</text>
          </view>
          <view bindtap="goCart" class="cart-btn">
            <text class="cart-icon">🛒</text>
          </view>
        </view>

        <view class="search-bar">
          <input class="search-input" placeholder="搜索品牌 / 产品名 / 色号" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" />
          <text wx:if="{{searchKeyword}}" bindtap="onClearSearch" class="search-clear">✕</text>
        </view>

        <view class="filter-bar">
          <view class="filter-bar-inner">
            <text class="filter-icon">💰</text>
          </view>
          <picker mode="selector" range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="onBudgetChange">
            <view class="picker-display">
              <text class="picker-text">{{budgetOptions[budgetIndex]}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>

        <view class="content-actions">
          <button bindtap="setViewMode" data-mode="swatch"
            class="{{viewMode==='swatch' ? 'btn-outline-active' : 'btn-outline'}}">按色号</button>
          <button bindtap="setViewMode" data-mode="brand"
            class="{{viewMode==='brand' ? 'btn-outline-active' : 'btn-outline'}}">按品牌</button>
        </view>
      </view>

      <scroll-view class="content-list" scroll-y="true">
        <block wx:if="{{viewMode==='swatch'}}">
          <view class="swatch-list">
            <block wx:for="{{swatches}}" wx:for-item="s" wx:for-index="i" wx:key="i">
              <view>
                <view class="swatch-item {{expandedKey===s.name ? 'swatch-item-expanded' : ''}}"
                  bindtap="onTapSwatch" data-key="{{s.name}}">
                  <view class="swatch-hexes">
                    <block wx:for="{{s.visibleHexes}}" wx:for-item="h" wx:key="h">
                      <view class="swatch-dot" style="background:{{h}}"></view>
                    </block>
                    <view wx:if="{{s.extraHexCount}}" class="swatch-more">+{{s.extraHexCount}}</view>
                    <block wx:if="{{s.showFallback}}">
                      <view class="swatch-dot" style="background:#f4f4f4"></view>
                    </block>
                  </view>
                  <view class="swatch-info">
                    <text class="name">{{s.name}}</text>
                    <text class="meta">{{s.items.length}} 款</text>
                  </view>
                  <text class="expand-icon">{{expandedKey===s.name ? '▾' : '▸'}}</text>
                </view>
                <block wx:if="{{expandedKey===s.name}}">
                  <view class="product-sublist">
                    <block wx:for="{{s.items}}" wx:for-item="item" wx:key="id">
                      <view class="product-item">
                        <view class="product-swatch" style="background:{{item.hex || '#f4f4f4'}}"></view>
                        <view style="flex:1;min-width:0">
                          <text class="product-brand">{{item.brand}}</text>
                          <text class="product-name">{{item.name}}</text>
                          <text class="product-price">¥{{item.price}}</text>
                        </view>
                        <button bindtap="onAddToCart" data-id="{{item.id}}" class="add-cart-btn">+</button>
                      </view>
                    </block>
                  </view>
                </block>
              </view>
            </block>
          </view>
          <block wx:if="{{swatches.length===0}}">
            <view class="empty-hint">该价位暂无匹配商品</view>
          </block>
        </block>

        <block wx:if="{{viewMode==='brand'}}">
          <block wx:for="{{brands}}" wx:for-item="b" wx:for-index="bi" wx:key="b">
            <view class="brand-group">
              <view class="list-item {{expandedBrand===b ? 'list-item-expanded' : ''}}">
                <view>
                  <text class="name">{{b}}</text>
                  <text class="meta" style="display:block">{{brandCounts[b] || 0}} 款</text>
                </view>
                <button bindtap="onViewBrand" data-brand="{{b}}" class="btn-primary">{{expandedBrand===b ? '收起' : '查看'}}</button>
              </view>
              <block wx:if="{{expandedBrand===b}}">
                <view class="brand-products">
                  <block wx:for="{{expandedBrandItems}}" wx:for-item="item" wx:key="id">
                    <view class="brand-product-item">
                      <view class="brand-product-swatch" style="background:{{item.hex || '#f4f4f4'}}"></view>
                      <view class="brand-product-info">
                        <text class="brand-product-name">{{item.name}}</text>
                        <text class="brand-product-meta">{{item.colorName}} · ¥{{item.price}}</text>
                      </view>
                      <button bindtap="onAddToCart" data-id="{{item.id}}" class="add-cart-btn">+</button>
                    </view>
                  </block>
                  <block wx:if="{{expandedBrandItems.length===0}}">
                    <view class="empty-hint" style="padding:16px">该价位暂无该品牌商品</view>
                  </block>
                </view>
              </block>
            </view>
          </block>
          <block wx:if="{{brands.length===0}}">
            <view class="empty-hint">该价位暂无匹配品牌</view>
          </block>
        </block>
      </scroll-view>
    </view>
  </view>
</view>
