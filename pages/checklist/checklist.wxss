.page-wrap{padding:6px}
.group-title{font-weight:700;padding:8px 6px;color:#2b2b2b}
.nav-item{padding:8px 10px;border-radius:10px;margin:6px 6px;color:#2b2b2b}
.nav-item-active{background:rgba(255,111,163,0.12)}
.grid{display:flex;flex-direction:column;gap:8px}
.swatch{width:40px;height:28px;border-radius:6px;border:1px solid rgba(0,0,0,0.06)}
.name{font-weight:700;color:#2b2b2b}
.meta{font-size:12px;color:#9b8b9b}
.card{padding:12px;border-radius:12px}
.cat-btn{margin-left:8px;padding:6px 10px;border-radius:10px;border:1px solid rgba(0,0,0,0.04)}
.btn-primary{background:#ff6fa3;color:#fff;padding:8px 12px;border-radius:10px;border:none}