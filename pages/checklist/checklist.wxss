.page-wrap {
  height: 100vh;
  overflow: hidden;
  background: var(--bg);
  color: var(--text);
}
.layout {
  display: flex;
  gap: 16px;
  padding: 16px;
  height: 100%;
  box-sizing: border-box;
  background: var(--bg);
}
.sidebar {
  width: 120px;
  height: 100%;
  background: var(--surface);
  border-radius: 16px;
  padding: 12px 0;
  border: 1px solid var(--border);
  flex-shrink: 0;
  box-sizing: border-box;
  overflow: hidden;
}
.content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.content-top {
  flex-shrink: 0;
}
.content-list {
  flex: 1;
  min-height: 0;
  overflow: hidden;
}
.content-list > view:last-child {
  padding-bottom: 80px;
}
.group-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12px;
  font-weight: 600;
  color: var(--text);
  padding: 14px 14px 4px;
  letter-spacing: 0.5px;
}
.group-arrow {
  font-size: 10px;
  color: var(--muted);
  transition: transform 0.2s;
}
.group-arrow-collapsed {
  transform: rotate(-90deg);
}
.nav-item {
  padding: 6px 14px;
  font-size: 12px;
  color: var(--muted);
  margin: 1px 6px;
  border-radius: 8px;
}
.nav-item-active {
  background: var(--primary-light);
  color: var(--text);
  font-weight: 500;
}
.content-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
}
.content-header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}
.content-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--text);
}
.result-count {
  font-size: 12px;
  color: var(--muted);
  background: var(--bg);
  padding: 4px 12px;
  border-radius: 20px;
}
.cart-btn {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--surface);
  border: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.cart-icon {
  font-size: 18px;
}
.search-bar {
  display: flex;
  align-items: center;
  background: var(--surface);
  border-radius: 14px;
  border: 1px solid var(--border);
  padding: 0 14px;
  margin-bottom: 10px;
}
.search-input {
  flex: 1;
  height: 40px;
  font-size: 13px;
  color: var(--text);
}
.search-clear {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--muted);
  color: var(--surface);
  font-size: 11px;
  text-align: center;
  line-height: 20px;
  flex-shrink: 0;
}
.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10px;
  padding: 8px 14px;
  background: var(--surface);
  border-radius: 14px;
  border: 1px solid var(--border);
}
.filter-bar-inner {
  display: flex;
  align-items: center;
  gap: 6px;
}
.filter-icon {
  font-size: 15px;
}
.picker-display {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 6px 12px;
  background: var(--chip-bg);
  border-radius: 10px;
  min-width: 130px;
  justify-content: space-between;
}
.picker-text {
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
}
.picker-arrow {
  font-size: 10px;
  color: var(--muted);
}
.content-actions {
  display: flex;
  gap: 8px;
  margin-bottom: 14px;
  align-items: center;
}
.swatch-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.swatch-item {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--surface);
  border-radius: 14px;
  padding: 12px;
  border: 1px solid var(--border);
  transition: border-radius 0.2s;
}
.swatch-item-expanded {
  border-radius: 14px 14px 0 0;
  border-bottom: none;
}
.swatch-hexes {
  display: flex;
  align-items: center;
  gap: 3px;
  flex-shrink: 0;
}
.swatch-dot {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 1px solid var(--border);
  flex-shrink: 0;
}
.swatch-more {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--bg);
  color: var(--muted);
  font-size: 8px;
  text-align: center;
  line-height: 16px;
  flex-shrink: 0;
}
.swatch-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}
.swatch-info .name {
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.swatch-info .meta {
  display: block;
  margin-top: 2px;
}
.expand-icon {
  font-size: 12px;
  color: var(--muted);
  padding: 4px;
}
.product-sublist {
  background: var(--surface);
  border: 1px solid var(--border);
  border-top: none;
  border-radius: 0 0 14px 14px;
  padding: 0 12px 8px;
  margin-bottom: 4px;
}
.product-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  border-top: 1px solid var(--bg);
}
.product-item:first-child {
  border-top: none;
}
.product-swatch {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 1px solid var(--border);
  flex-shrink: 0;
}
.product-brand {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  display: block;
}
.product-name {
  font-size: 12px;
  color: var(--muted);
  display: block;
  margin-top: 1px;
}
.product-price {
  font-size: 14px;
  font-weight: 600;
  color: var(--primary);
  display: block;
  margin-top: 2px;
}
.add-cart-btn {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--primary-light);
  color: var(--primary);
  border: none;
  font-size: 18px;
  font-weight: 300;
  line-height: 32px;
  text-align: center;
  padding: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.add-cart-btn:active {
  background: var(--primary);
  color: var(--surface);
}
.empty-hint {
  text-align: center;
  padding: 40px 16px;
  color: var(--muted);
  font-size: 13px;
}
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: var(--surface);
  border-radius: 14px;
  border: 1px solid var(--border);
  margin-bottom: 8px;
}
.list-item-expanded {
  border-radius: 14px 14px 0 0;
  margin-bottom: 0;
  border-bottom: none;
}
.list-item .name {
  display: block;
}
.list-item .meta {
  display: block;
  margin-top: 2px;
}
.list-item .btn-primary {
  margin: 0;
  flex-shrink: 0;
}
.brand-group {
  margin-bottom: 8px;
}
.brand-products {
  background: var(--surface);
  border: 1px solid var(--border);
  border-top: none;
  border-radius: 0 0 14px 14px;
  padding: 0 12px 8px;
  margin-bottom: 8px;
}
.brand-product-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  border-top: 1px solid var(--bg);
}
.brand-product-item:first-child {
  border-top: none;
}
.brand-product-swatch {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  flex-shrink: 0;
}
.brand-product-info {
  flex: 1;
  min-width: 0;
}
.brand-product-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  display: block;
}
.brand-product-meta {
  font-size: 11px;
  color: var(--muted);
  display: block;
  margin-top: 1px;
}
