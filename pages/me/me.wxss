.page-wrap {
  padding: 20px 16px 90px;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  color: var(--text);
}
.profile-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 24px;
}
.avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-icon {
  font-size: 26px;
}
.profile-name {
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
}
.section-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 14px;
}
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.section-title-right {
  display: flex;
  align-items: center;
  gap: 8px;
}
.section-arrow {
  font-size: 10px;
  color: var(--muted);
  transition: transform 0.2s;
}
.section-arrow-collapsed {
  transform: rotate(-90deg);
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}
.section-hint {
  font-size: 11px;
  color: var(--muted);
}
.profile-fields {
  margin-bottom: 14px;
}
.profile-row {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-top: 1px solid var(--bg);
}
.profile-row:first-child {
  border-top: none;
}
.row-label {
  font-size: 13px;
  color: var(--muted);
  width: 72px;
  flex-shrink: 0;
}
.row-value {
  flex: 1;
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
}
.row-arrow {
  font-size: 12px;
  color: var(--muted);
  margin-left: 8px;
}
.btn-full {
  width: 100%;
  text-align: center;
  padding: 10px;
  font-size: 13px;
  border-radius: 10px;
  box-sizing: border-box;
}
.picker-chip {
  padding: 6px 12px;
  background: var(--chip-bg);
  border-radius: 8px;
  font-size: 13px;
  color: var(--text);
}
.recent-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  border-top: 1px solid var(--bg);
}
.recent-item .swatch {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1px solid var(--border);
}
.recent-item:first-of-type {
  border-top: none;
}
.recent-info {
  flex: 1;
  min-width: 0;
}
.recent-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
  display: block;
}
.recent-meta {
  font-size: 11px;
  color: var(--muted);
  display: block;
  margin-top: 1px;
}
