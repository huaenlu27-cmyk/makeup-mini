.page-wrap {
  padding: 20px 16px 90px;
  min-height: 100vh;
  box-sizing: border-box;
}
.profile-header {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 24px;
}
.avatar {
  width: 56px;
  height: 56px;
  border-radius: 50%;
  background: #F5D6DF;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-img {
  width: 100%;
  height: 100%;
}
.avatar-icon {
  font-size: 26px;
}
.profile-name {
  font-size: 20px;
  font-weight: 700;
  color: #3A2A30;
}
.section-card {
  background: #FFFFFF;
  border: 1px solid #EDE4E7;
  border-radius: 14px;
  padding: 16px;
  margin-bottom: 14px;
}
.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}
.section-title-right {
  display: flex;
  align-items: center;
  gap: 8px;
}
.section-arrow {
  font-size: 10px;
  color: #CAB8BF;
  transition: transform 0.2s;
}
.section-arrow-collapsed {
  transform: rotate(-90deg);
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  color: #3A2A30;
}
.section-hint {
  font-size: 11px;
  color: #CAB8BF;
}
.profile-fields {
  margin-bottom: 14px;
}
.profile-row {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-top: 1px solid #F5F0F2;
}
.profile-row:first-child {
  border-top: none;
}
.row-label {
  font-size: 13px;
  color: #A89098;
  width: 72px;
  flex-shrink: 0;
}
.row-value {
  flex: 1;
  font-size: 13px;
  font-weight: 500;
  color: #3A2A30;
}
.row-arrow {
  font-size: 12px;
  color: #CAB8BF;
  margin-left: 8px;
}
.btn-full {
  width: 100%;
  text-align: center;
  padding: 10px;
  font-size: 13px;
  border-radius: 10px;
  box-sizing: border-box;
}
.picker-chip {
  padding: 6px 12px;
  background: #F8F4F6;
  border-radius: 8px;
  font-size: 13px;
  color: #3A2A30;
}
.recent-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  border-top: 1px solid #F5F0F2;
}
.recent-item .swatch {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  flex-shrink: 0;
  border: 1px solid #EDE4E7;
}
.recent-item:first-of-type {
  border-top: none;
}
.recent-info {
  flex: 1;
  min-width: 0;
}
.recent-name {
  font-size: 13px;
  font-weight: 500;
  color: #3A2A30;
  display: block;
}
.recent-meta {
  font-size: 11px;
  color: #A89098;
  display: block;
  margin-top: 1px;
}
