<view class="page-wrap" style="background:{{theme.colors.primaryBg}};color:{{theme.colors.text}}">
  <view class="profile-header">
    <view class="avatar" bindtap="onTapAvatar">
      <image wx:if="{{userAvatar}}" class="avatar-img" src="{{userAvatar}}" mode="aspectFill"></image>
      <text wx:else class="avatar-icon">👤</text>
    </view>
    <text class="profile-name" bindtap="onTapName">{{userName || '我的'}}</text>
  </view>

  <view class="section-card">
    <view class="section-title-row">
      <text class="section-title">肤色档案</text>
    </view>
    <view wx:if="{{profile}}" class="profile-fields">
      <picker mode="selector" range="{{faceShapeNames}}" value="{{faceShapeIndex}}" bindchange="onPickerFace">
        <view class="profile-row">
          <text class="row-label">脸型</text>
          <view class="row-value">{{profile.faceShapeName || profile.faceShape}}</view>
          <text class="row-arrow">▸</text>
        </view>
      </picker>
      <picker mode="selector" range="{{depthNames}}" value="{{depthIndex}}" bindchange="onPickerDepth">
        <view class="profile-row">
          <text class="row-label">肤色深浅</text>
          <view class="row-value">{{profile.depthName || profile.depth}}</view>
          <text class="row-arrow">▸</text>
        </view>
      </picker>
      <picker mode="selector" range="{{undertoneNames}}" value="{{undertoneIndex}}" bindchange="onPickerUndertone">
        <view class="profile-row">
          <text class="row-label">肤色基调</text>
          <view class="row-value">{{profile.undertoneName || profile.undertone}}</view>
          <text class="row-arrow">▸</text>
        </view>
      </picker>
      <picker mode="selector" range="{{occasionNames}}" value="{{occasionIndex}}" bindchange="onPickerOccasion">
        <view class="profile-row">
          <text class="row-label">场景</text>
          <view class="row-value">{{profile.occasionName || profile.occasion}}</view>
          <text class="row-arrow">▸</text>
        </view>
      </picker>
      <picker mode="selector" range="{{skinTypeNames}}" value="{{skinTypeIndex}}" bindchange="onPickerSkinType">
        <view class="profile-row">
          <text class="row-label">肤质</text>
          <view class="row-value">{{profile.skinTypeName || profile.skinType}}</view>
          <text class="row-arrow">▸</text>
        </view>
      </picker>
    </view>
    <button bindtap="goRecommend" class="btn-primary btn-full">去生成推荐方案</button>
  </view>

  <view class="section-card">
    <text class="section-title">偏好设置</text>
    <view class="profile-row">
      <text class="row-label">默认价位</text>
      <picker mode="selector" range="{{budgetOptions}}" value="{{budgetIndex}}" bindchange="onBudgetChange">
        <view class="picker-chip">{{budgetOptions[budgetIndex]}}</view>
      </picker>
    </view>
  </view>

  <view wx:if="{{recentProducts.length>0}}" class="section-card">
    <view class="section-title-row" bindtap="onToggleRecent">
      <text class="section-title">最近浏览</text>
      <view class="section-title-right">
        <text class="section-hint">最多 10 件</text>
        <text class="section-arrow {{recentCollapsed ? 'section-arrow-collapsed' : ''}}">▾</text>
      </view>
    </view>
    <block wx:if="{{!recentCollapsed}}" wx:for="{{recentProducts}}" wx:for-item="item" wx:key="id">
      <view class="recent-item">
        <view class="swatch" style="background:{{item.hex || '#f4f4f4'}}"></view>
        <view class="recent-info">
          <text class="recent-name">{{item.name}}</text>
          <text class="recent-meta">{{item.brand}} · ¥{{item.price}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
