.page-wrap {
  padding: 20px 16px 90px;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
  color: var(--text);
}
.page-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 4px;
}
.page-subtitle {
  font-size: 12px;
  color: var(--muted);
  display: block;
  margin-bottom: 20px;
}
.mode-tabs {
  display: flex;
  background: var(--surface);
  border-radius: 14px;
  padding: 4px;
  border: 1px solid var(--border);
  margin-bottom: 20px;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  border-radius: 12px;
}
.mode-tab-active {
  background: var(--primary-light);
  color: var(--text);
  font-weight: 600;
}
.section {
  margin-bottom: 20px;
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  display: block;
  margin-bottom: 10px;
}
.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}
.section-title-wrap .section-title {
  margin-bottom: 0;
}
.tip-wrapper {
  position: relative;
  display: inline-flex;
}
.tip-icon {
  font-size: 10px;
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  line-height: 1;
}
.card-scroll {
  overflow: hidden;
  margin-bottom: 10px;
}
.card-row {
  display: flex;
  gap: 10px;
  padding: 4px 0;
}
.sel-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 12px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  min-width: 60px;
}
.sel-card-active {
  border-color: var(--primary);
  background: var(--chip-bg);
}
.sel-card-label {
  font-size: 11px;
  color: var(--text);
  font-weight: 500;
}
.face-detail-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 16px;
  margin-top: 4px;
}
.face-detail-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}
.face-detail-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}
.face-detail-desc {
  font-size: 12px;
  color: var(--text);
  line-height: 1.6;
  display: block;
  margin-bottom: 8px;
}
.face-detail-row {
  display: flex;
  gap: 4px;
  margin-top: 4px;
}
.face-detail-label {
  font-size: 12px;
  color: var(--muted);
  flex-shrink: 0;
}
.face-detail-value {
  font-size: 12px;
  color: var(--text);
}
.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 20px;
  font-size: 12px;
  color: var(--text);
}
.chip-active {
  border-color: var(--primary);
  background: var(--chip-bg);
}
.chip-color {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  flex-shrink: 0;
}
.ai-section {
  margin-bottom: 20px;
}
.ai-input {
  width: 100%;
  min-height: 120px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 16px;
  font-size: 13px;
  color: var(--text);
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 14px;
}
.ai-input::placeholder {
  color: var(--muted);
}
.clear-hint {
  font-size: 11px;
  color: var(--muted);
  margin-left: auto;
}
.history-item {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 12px 14px;
  margin-bottom: 8px;
}
.history-input {
  font-size: 13px;
  color: var(--text);
  line-height: 1.5;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.history-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 6px;
}
.history-time {
  font-size: 11px;
  color: var(--muted);
}
.history-del {
  font-size: 11px;
  color: var(--primary);
  padding: 4px 8px;
}
.gen-btn-wrap {
  margin-top: 24px;
  text-align: center;
}
.btn-gen {
  padding: 12px 32px;
  font-size: 14px;
  border-radius: 24px;
}
.result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16px;
}
.result-header-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}
.result-title {
  font-size: 18px;
  font-weight: 700;
  color: var(--text);
}
.result-subtitle {
  font-size: 12px;
  color: var(--muted);
}
.btn-share-text {
  font-size: 11px;
  color: var(--primary);
  background: var(--primary-light);
  border: none;
  padding: 4px 12px;
  margin: 0;
  line-height: 1.4;
  min-width: 0;
  border-radius: 12px;
  height: auto;
}
.btn-share-text::after {
  border: none;
}
.btn-add-all {
  width: 100%;
  padding: 12px;
  font-size: 14px;
  border-radius: 12px;
  text-align: center;
}
.action-row {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}
.action-row .btn-add-all {
  flex: 1;
  width: auto;
}
.btn-regenerate-action {
  flex-shrink: 0;
  padding: 12px 14px;
  font-size: 13px;
  border-radius: 12px;
}
.rec-group {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 16px;
  margin-bottom: 12px;
}
.rec-group-header {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}
.rec-group-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
}
.rec-group-count {
  font-size: 11px;
  color: var(--muted);
  margin-left: auto;
}
.rec-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  border-top: 1px solid var(--bg);
}
.rec-item:first-of-type {
  border-top: none;
}
.rec-item-swatch {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  flex-shrink: 0;
}
.rec-item-info {
  flex: 1;
  min-width: 0;
}
.rec-item-brand {
  font-size: 12px;
  color: var(--muted);
  display: block;
}
.rec-item-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
  display: block;
}
.rec-item-tags {
  display: flex;
  gap: 8px;
  margin-top: 4px;
}
.tag {
  font-size: 11px;
  color: var(--primary);
  background: var(--chip-bg);
  padding: 2px 8px;
  border-radius: 6px;
}
.rec-item-price {
  font-size: 12px;
  font-weight: 600;
  color: var(--primary);
}
.tip-card {
  background: var(--chip-bg);
  border-color: var(--primary-light);
}
.tip-text {
  font-size: 12px;
  color: var(--text);
  line-height: 1.6;
  display: block;
}
.tip-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 90;
  background: transparent;
}
.tip-float {
  position: fixed;
  z-index: 100;
  background: var(--text);
  border-radius: 10px;
  padding: 10px 12px;
  max-width: 260px;
}
.tip-float-arrow {
  position: absolute;
  top: -6px;
  left: 16px;
  width: 0;
  height: 0;
  border-left: 6px solid transparent;
  border-right: 6px solid transparent;
  border-bottom: 6px solid var(--text);
}
.tip-float-text {
  font-size: 12px;
  color: var(--surface);
  line-height: 1.6;
}
