.page-wrap {
  padding: 20px 16px 30px;
  min-height: 100vh;
  box-sizing: border-box;
}
.page-title {
  font-size: 20px;
  font-weight: 700;
  color: #3A2A30;
  margin-bottom: 4px;
}
.page-subtitle {
  font-size: 12px;
  color: #A89098;
  display: block;
  margin-bottom: 20px;
}
.mode-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 14px;
  padding: 4px;
  border: 1px solid #EDE4E7;
  margin-bottom: 20px;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 10px;
  font-size: 13px;
  font-weight: 500;
  color: #A89098;
  border-radius: 12px;
}
.mode-tab-active {
  background: #F5D6DF;
  color: #3A2A30;
  font-weight: 600;
}
.section {
  margin-bottom: 20px;
}
.section-title {
  font-size: 14px;
  font-weight: 600;
  color: #3A2A30;
  display: block;
  margin-bottom: 10px;
}
.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}
.section-title-wrap .section-title {
  margin-bottom: 0;
}
.tip-wrapper {
  position: relative;
  display: inline-flex;
}
.tip-icon {
  font-size: 10px;
  color: #CAB8BF;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  line-height: 1;
}
.card-scroll {
  overflow: hidden;
  margin-bottom: 10px;
}
.card-row {
  display: flex;
  gap: 10px;
  padding: 4px 0;
}
.sel-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 12px 14px;
  background: #FFFFFF;
  border: 1px solid #EDE4E7;
  border-radius: 14px;
  min-width: 60px;
}
.sel-card-active {
  border-color: #E595A8;
  background: #FDF6F8;
}
.sel-card-label {
  font-size: 11px;
  color: #3A2A30;
  font-weight: 500;
}
.face-detail-card {
  background: #FFFFFF;
  border: 1px solid #EDE4E7;
  border-radius: 14px;
  padding: 14px 16px;
  margin-top: 4px;
}
.face-detail-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}
.face-detail-name {
  font-size: 14px;
  font-weight: 600;
  color: #3A2A30;
}
.face-detail-desc {
  font-size: 12px;
  color: #6A5A60;
  line-height: 1.6;
  display: block;
  margin-bottom: 8px;
}
.face-detail-row {
  display: flex;
  gap: 4px;
  margin-top: 4px;
}
.face-detail-label {
  font-size: 12px;
  color: #A89098;
  flex-shrink: 0;
}
.face-detail-value {
  font-size: 12px;
  color: #3A2A30;
}
.option-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  background: #FFFFFF;
  border: 1px solid #EDE4E7;
  border-radius: 20px;
  font-size: 12px;
  color: #3A2A30;
}
.chip-active {
  border-color: #E595A8;
  background: #FDF6F8;
}
.chip-color {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  flex-shrink: 0;
}
.gen-btn-wrap {
  margin-top: 24px;
  text-align: center;
}
.btn-gen {
  padding: 12px 32px;
  font-size: 14px;
  border-radius: 24px;
}
.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}
.result-header-left {
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.result-title {
  font-size: 18px;
  font-weight: 700;
  color: #3A2A30;
}
.result-subtitle {
  font-size: 12px;
  color: #A89098;
}
.btn-regenerate {
  font-size: 11px;
  padding: 6px 12px;
}
.rec-group {
  background: #FFFFFF;
  border: 1px solid #EDE4E7;
  border-radius: 14px;
  padding: 14px 16px;
  margin-bottom: 12px;
}
.rec-group-header {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
}
.rec-group-title {
  font-size: 14px;
  font-weight: 600;
  color: #3A2A30;
}
.rec-group-count {
  font-size: 11px;
  color: #A89098;
  margin-left: auto;
}
.rec-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 0;
  border-top: 1px solid #F5F0F2;
}
.rec-item:first-of-type {
  border-top: none;
}
.rec-item-swatch {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  flex-shrink: 0;
}
.rec-item-info {
  flex: 1;
  min-width: 0;
}
.rec-item-brand {
  font-size: 12px;
  color: #A89098;
  display: block;
}
.rec-item-name {
  font-size: 13px;
  font-weight: 500;
  color: #3A2A30;
  display: block;
}
.rec-item-tags {
  display: flex;
  gap: 8px;
  margin-top: 4px;
}
.tag {
  font-size: 11px;
  color: #C97A8F;
  background: #FDF6F8;
  padding: 2px 8px;
  border-radius: 6px;
}
.rec-item-price {
  font-size: 12px;
  font-weight: 600;
  color: #E595A8;
}
.tip-card {
  background: #FDF6F8;
  border-color: #F5D6DF;
}
.tip-text {
  font-size: 12px;
  color: #6A5A60;
  line-height: 1.6;
  display: block;
}
.tip-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 90;
  background: transparent;
}
.tip-float {
  position: fixed;
  z-index: 100;
  background: #3A2A30;
  border-radius: 10px;
  padding: 10px 12px;
  max-width: 260px;
}
.tip-float-arrow {
  position: absolute;
  top: -6px;
  left: 16px;
  width: 0;
  height: 0;
  border-left: 6px solid transparent;
  border-right: 6px solid transparent;
  border-bottom: 6px solid #3A2A30;
}
.tip-float-text {
  font-size: 12px;
  color: #FFFFFF;
  line-height: 1.6;
}
